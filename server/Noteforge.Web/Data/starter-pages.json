    "blocks": [
      {
        "id": "h-intro",
        "type": "callout",
        "text": "A little space for your biggest ideas. Everything here is editable — make yourself at home."
      },
      {
        "id": "h-1",
        "type": "heading2",
        "text": "Your work, connected"
      },
      {
        "id": "h-2",
        "type": "text",
        "text": "Bring your notes, plans, and projects together. Start with a page, write a thought, and let it grow."
      },
      {
        "id": "h-3",
        "type": "heading2",
        "text": "Try a few things"
      },
      {
        "id": "h-4",
        "type": "todo",
        "text": "Write your first note",
        "checked": false
      },
      {
        "id": "h-5",
        "type": "todo",
        "text": "Create a page inside another page",
        "checked": false
      },
      {
        "id": "h-6",
        "type": "todo",
        "text": "Switch the Project tracker from table to board",
        "checked": false
      },
      {
        "id": "h-7",
        "type": "divider",
        "text": ""
      },
      {
        "id": "h-8",
        "type": "heading2",
        "text": "A blank page is a good beginning"
      },
      {
        "id": "h-9",
        "type": "text",
        "text": "Click any line to edit. Press Enter for a new block, or type / to choose a heading, checklist, quote, and more."
      },
      {
        "id": "h-10",
        "type": "quote",
        "text": "Great things are done by a series of small things brought together."
      }
